# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ignora RLS por completo. Só em código server-only (seed, webhooks).
SUPABASE_SERVICE_ROLE_KEY=

# Senha dos usuários de demonstração criados por `npm run seed`.
SEED_PASSWORD=

# Stripe — use chaves de teste (sk_test_/pk_test_) fora de produção.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Id do PREÇO do plano Pro (price_...), não o do produto (prod_...).
STRIPE_PRICE_ID_PRO=
# Sai do `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
